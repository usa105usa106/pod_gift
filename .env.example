# Real secrets must be set only in Coolify, never commit them to GitHub.
BOT_TOKEN=1234567890:replace_me
SETUP_PIN=replace_with_private_pin

DATA_DIR=/app/data

# Adaptive scanner: starts fast, accelerates after successful cycles and
# automatically backs off when Telegram returns FLOOD_WAIT.
ADAPTIVE_SCAN=true
SCAN_START_INTERVAL_MS=120
SCAN_MIN_INTERVAL_MS=0
SCAN_MAX_INTERVAL_MS=2000
SCAN_ACCELERATE_EVERY=4
SCAN_ACCELERATE_FACTOR=0.75
SCAN_BACKOFF_FACTOR=2.0
SCAN_BACKOFF_FLOOR_MS=100
FLOOD_WAIT_EXTRA_MS=150
NEAR_TARGET_DISTANCE=25

PREPARE_AHEAD=100
PREPARE_REFRESH_SECONDS=420
MAX_UPGRADE_STARS=2000
KEEP_ORIGINAL_DETAILS=true
STOP_AFTER_SUCCESS=false
DIAGNOSTICS_INTERVAL_SECONDS=1.0
LIVE_STATUS_INTERVAL_SECONDS=3.0
STRESS_STATUS_INTERVAL_SECONDS=3.0
STATUS_REPLACE_AFTER_FAILURES=2
STATUS_REPLACE_COOLDOWN_SECONDS=5.0
HEALTHCHECK_MAX_AGE_SECONDS=45
TASK_STOP_TIMEOUT_SECONDS=4.0
CATALOG_CONCURRENCY=6
LOG_LEVEL=INFO

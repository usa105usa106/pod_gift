# Coolify: these are the only required variables at first deploy.
BOT_TOKEN=1234567890:replace_with_hunter_1_token
SETUP_PIN=replace_with_private_pin
# FIRE_SECRET is optional; Hunter 1 generates and persists it automatically.
FIRE_SECRET=

# Shared cluster transport. Keep the UDP port internal; do not publish it.
FIRE_PORT=45444
CLUSTER_STATUS_INTERVAL_SECONDS=60
CLUSTER_STALE_SECONDS=180
CLUSTER_PING_TIMEOUT_MS=500
# Active participants use a local config fallback check; authenticated UDP notice is immediate.
CLUSTER_CONFIG_POLL_SECONDS=2.0
# A new generation must be read identically this many times before sleep/activation.
CLUSTER_CONFIG_STABLE_READS=2
# One-time acknowledgement window after Hunter 1 changes the composition.
CLUSTER_RECONFIG_CONFIRM_SECONDS=10.0
# Sleeping Hunter 2–6 check only the shared provision volume at this cadence.
BOOTSTRAP_POLL_SECONDS=2.0
# Independent process watchdog. Docker restarts the process after a confirmed loop stall.
WATCHDOG_STALL_SECONDS=90.0
WATCHDOG_CHECK_SECONDS=5.0

# Scanner
ADAPTIVE_SCAN=true
SCAN_START_INTERVAL_MS=120
SCAN_MIN_INTERVAL_MS=0
SCAN_MAX_INTERVAL_MS=2000
SCAN_ACCELERATE_EVERY=4
SCAN_ACCELERATE_FACTOR=0.75
SCAN_BACKOFF_FACTOR=2.0
SCAN_BACKOFF_FLOOR_MS=100
FLOOD_WAIT_EXTRA_MS=150
NEAR_TARGET_DISTANCE=25
EXACT_PROBE_DISTANCE=100
EXACT_COUNTER_REFRESH_SECONDS=1.0

# FAST hot path
FAST_QUIET_DISTANCE=10
FAST_DISABLE_GC=true
HUNTER_1_CPU=
HUNTER_2_CPU=
HUNTER_3_CPU=
HUNTER_4_CPU=
HUNTER_5_CPU=
HUNTER_6_CPU=

# Payment forms
PREPARE_AHEAD=100
PREPARE_REFRESH_SECONDS=420
MAX_UPGRADE_STARS=3000
KEEP_ORIGINAL_DETAILS=true
STOP_AFTER_SUCCESS=false

# UI / diagnostics
DIAGNOSTICS_INTERVAL_SECONDS=1.0
LIVE_STATUS_INTERVAL_SECONDS=60.0
STATUS_MANUAL_REFRESH_COOLDOWN_SECONDS=60.0
STATUS_URGENT_MIN_INTERVAL_SECONDS=1.0
STATUS_TRANSIENT_FAILURE_COOLDOWN_SECONDS=60.0
HEALTHCHECK_MAX_AGE_SECONDS=45
TASK_STOP_TIMEOUT_SECONDS=4.0
CATALOG_CONCURRENCY=6
LOG_LEVEL=INFO
